# temperature control. We need lower P/I values
# to prevent oscillation of the BMI088 temperature
# the ADIS16470 is factory temperature calibrated,
# but the BMI088 isn't, so temperature control is still
# worthwhile
BRD_HEAT_TARG 45
BRD_HEAT_P 50
BRD_HEAT_I 0.07

//VIN
BATT_MONITOR  4
BATT_VOLT_PIN 16
BATT_VOLT_MULT 21

//AIN3
BATT2_MONITOR 4
BATT2_VOLT_PIN 18
BATT2_VOLT_MULT 21

//AIN1
BATT3_VOLT_PIN 17
BATT3_VOLT_MULT 21

//AIN2
BATT4_VOLT_PIN 4
BATT4_VOLT_MULT 21